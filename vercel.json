{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/((?!_next/static|_next/image).*)",
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": { "key": "vary" },
          "args": ["Accept"]
        }
      ]
    }
  ]
}
